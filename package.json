{
	"name": "github-issues",
	"version": "1.10.0",
	"description": "Sync issues and pull requests from GitHub, GitLab, Gitea and more.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"typecheck": "tsc -noEmit -skipLibCheck",
		"lint": "eslint src",
		"format": "prettier . --write",
		"format:check": "prettier . --check",
		"test": "vitest run",
		"version": "node version-bump.mjs"
	},
	"keywords": [
		"obsidian",
		"github",
		"gitlab",
		"tracker",
		"issues",
		"pull-requests",
		"merge-requests"
	],
	"author": "LonoxX",
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^26.6.6",
		"esbuild": "^0.28.2",
		"eslint": "^10.15.0",
		"eslint-plugin-obsidianmd": "^0.6.0",
		"obsidian": "^1.14.4",
		"prettier": "^3.10.1",
		"tslib": "^2.9.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.73.0",
		"vitest": "^5.1.1"
	},
	"dependencies": {
		"date-fns": "4.4.0",
		"octokit": "5.0.5"
	}
}
